<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Published self-contained, as in the MSIX: compiled ahead of time into one 6 MB exe. That needs the C++ build
         tools (Visual Studio's "Desktop development with C++"); without them, -p:PublishAot=false gives a trimmed
         build of 22 MB instead. Untrimmed it would be 80 MB. IsAotCompatible reports code that would break either. -->
    <PublishAot Condition="'$(SelfContained)' == 'true' and '$(PublishAot)' == ''">true</PublishAot>
    <PublishTrimmed Condition="'$(SelfContained)' == 'true'">true</PublishTrimmed>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Firmly.Service.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Firmly.Core\Firmly.Core.csproj" />
    <ProjectReference Include="..\Firmly.Ipc\Firmly.Ipc.csproj" />
  </ItemGroup>
</Project>
