<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Firmly.App.Pages.BatteryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Firmly.App.ViewModels">

    <ScrollViewer>
        <StackPanel Padding="32,16,32,24" Spacing="4">
            <Grid Margin="0,0,0,12" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="Battery" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock
                        Text="{x:Bind Session.Status, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Command="{x:Bind Session.RefreshCommand}"
                    AutomationProperties.Name="Refresh"
                    ToolTipService.ToolTip="Refresh">
                    <SymbolIcon Symbol="Refresh" />
                </Button>
            </Grid>

            <Grid Style="{StaticResource CardStyle}" Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind Session.Battery.Charge, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        Text="{x:Bind Session.Battery.Details, Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <InfoBar
                Margin="0,12,0,0"
                IsOpen="{x:Bind Session.Charge.HasOverride, Mode=OneWay}"
                IsClosable="False"
                Severity="Success"
                Title="{x:Bind Session.Charge.OverrideTitle, Mode=OneWay}"
                Message="{x:Bind Session.Charge.OverrideMessage, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button
                        Content="Switch back now"
                        Command="{x:Bind Session.Charge.SwitchBackNowCommand}"
                        IsEnabled="{x:Bind Session.Charge.CanChange, Mode=OneWay}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <StackPanel Spacing="4" Visibility="{x:Bind Session.Charge.HasModes, Mode=OneWay}">
                <TextBlock Text="Charge mode" Style="{StaticResource SectionHeaderStyle}" />
                <Grid Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="4">
                        <!-- One-way: user picks are handled in code-behind, never through the binding. -->
                        <RadioButtons
                            AutomationProperties.Name="Charge mode"
                            ItemsSource="{x:Bind Session.Charge.Modes}"
                            SelectedIndex="{x:Bind Session.Charge.SelectedIndex, Mode=OneWay}"
                            IsEnabled="{x:Bind Session.Charge.CanChange, Mode=OneWay}"
                            SelectionChanged="OnModeSelectionChanged">
                            <RadioButtons.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChargeModeOption">
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{x:Bind Label}" />
                                        <TextBlock
                                            Text="{x:Bind Explanation}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </RadioButtons.ItemTemplate>
                        </RadioButtons>
                        <TextBlock
                            Text="{x:Bind Session.Charge.Note, Mode=OneWay}"
                            Visibility="{x:Bind Session.Charge.HasNote, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <StackPanel Spacing="4" Visibility="{x:Bind Session.Charge.IsOverrideOffered, Mode=OneWay}">
                <TextBlock Text="Full charge for a while" Style="{StaticResource SectionHeaderStyle}" />
                <Grid Style="{StaticResource CardStyle}" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        TextWrapping="Wrap"
                        Text="Charges to 100% now, and switches back by itself when the time is up, even if Firmly isn't open. Handy before a trip." />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                        <TextBlock VerticalAlignment="Center" Text="For" />
                        <ComboBox
                            AutomationProperties.Name="How long"
                            ItemsSource="{x:Bind Session.Charge.Durations}"
                            DisplayMemberPath="Label"
                            SelectedIndex="{x:Bind Session.Charge.DurationIndex, Mode=TwoWay}" />
                        <TextBlock VerticalAlignment="Center" Text="then" />
                        <ComboBox
                            AutomationProperties.Name="Then switch back to"
                            ItemsSource="{x:Bind Session.Charge.RestoreModes}"
                            DisplayMemberPath="Label"
                            SelectedIndex="{x:Bind Session.Charge.RestoreIndex, Mode=TwoWay}" />
                        <Button
                            Content="Start"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind Session.Charge.StartOverrideCommand}"
                            IsEnabled="{x:Bind Session.Charge.CanChange, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
