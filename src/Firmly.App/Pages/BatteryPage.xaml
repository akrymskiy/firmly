<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Firmly.App.Pages.BatteryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Firmly.App.ViewModels">

    <ScrollViewer>
        <StackPanel Padding="24,16,24,24" Spacing="4">
            <Grid Margin="0,0,0,12" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock x:Uid="Battery_Title" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock
                        Text="{x:Bind Session.Status, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    x:Uid="Battery_Refresh"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Command="{x:Bind Session.RefreshCommand}">
                    <SymbolIcon Symbol="Refresh" />
                </Button>
            </Grid>

            <Grid Style="{StaticResource CardStyle}" Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind Session.Battery.Charge, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        Text="{x:Bind Session.Battery.Details, Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <InfoBar
                Margin="0,12,0,0"
                IsOpen="{x:Bind Session.Charge.HasOverride, Mode=OneWay}"
                Visibility="{x:Bind Session.Charge.HasOverride, Mode=OneWay}"
                IsClosable="False"
                Severity="{x:Bind Session.Charge.OverrideSeverity, Mode=OneWay}"
                Title="{x:Bind Session.Charge.OverrideTitle, Mode=OneWay}"
                Message="{x:Bind Session.Charge.OverrideMessage, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button
                        x:Uid="Battery_SwitchBackNow"
                        Command="{x:Bind Session.Charge.SwitchBackNowCommand}"
                        IsEnabled="{x:Bind Session.Charge.CanChange, Mode=OneWay}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar
                x:Uid="Battery_EndNote"
                Margin="0,12,0,0"
                IsOpen="{x:Bind Session.Charge.HasEndNote, Mode=OneWay}"
                Visibility="{x:Bind Session.Charge.HasEndNote, Mode=OneWay}"
                Severity="{x:Bind Session.Charge.EndNoteSeverity, Mode=OneWay}"
                Message="{x:Bind Session.Charge.EndNoteMessage, Mode=OneWay}"
                CloseButtonCommand="{x:Bind Session.Charge.DismissEndNoteCommand}" />

            <InfoBar
                x:Uid="Battery_StartupPrompt"
                Margin="0,12,0,0"
                IsOpen="{x:Bind StartupPrompt.IsOpen, Mode=OneWay}"
                Visibility="{x:Bind StartupPrompt.IsOpen, Mode=OneWay}"
                Severity="Informational"
                CloseButtonCommand="{x:Bind StartupPrompt.DismissCommand}">
                <InfoBar.ActionButton>
                    <Button x:Uid="Battery_StartupPromptTurnOn" Command="{x:Bind StartupPrompt.TurnOnCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <StackPanel Spacing="4" Visibility="{x:Bind Session.Charge.HasModes, Mode=OneWay}">
                <TextBlock x:Uid="Battery_ChargeMode" Style="{StaticResource SectionHeaderStyle}" />
                <Grid Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="4">
                        <!-- One-way: user picks are handled in code-behind, never through the binding. -->
                        <RadioButtons
                            x:Uid="Battery_ChargeModePicker"
                            ItemsSource="{x:Bind Session.Charge.Modes}"
                            SelectedIndex="{x:Bind Session.Charge.SelectedIndex, Mode=OneWay}"
                            IsEnabled="{x:Bind Session.Charge.CanChange, Mode=OneWay}"
                            SelectionChanged="OnModeSelectionChanged">
                            <RadioButtons.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChargeModeOption">
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{x:Bind Label}" />
                                        <TextBlock
                                            Text="{x:Bind Explanation}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </RadioButtons.ItemTemplate>
                        </RadioButtons>
                        <TextBlock
                            Text="{x:Bind Session.Charge.Note, Mode=OneWay}"
                            Visibility="{x:Bind Session.Charge.HasNote, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <StackPanel Spacing="4" Visibility="{x:Bind Session.Charge.IsOverrideOffered, Mode=OneWay}">
                <TextBlock x:Uid="Battery_FullChargeHeader" Style="{StaticResource SectionHeaderStyle}" />
                <Grid Style="{StaticResource CardStyle}" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        x:Uid="Battery_FullChargeExplanation"
                        TextWrapping="Wrap" />
                    <StackPanel Grid.Row="1" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Uid="Battery_For" VerticalAlignment="Center" />
                            <ComboBox
                                x:Uid="Battery_HowLong"
                                ItemsSource="{x:Bind Session.Charge.Durations}"
                                DisplayMemberPath="Label"
                                SelectedIndex="{x:Bind Session.Charge.DurationIndex, Mode=TwoWay}" />
                            <CalendarDatePicker
                                x:Uid="Battery_UntilTheDay"
                                Visibility="{x:Bind Session.Charge.IsCustomDuration, Mode=OneWay}"
                                Date="{x:Bind Session.Charge.CustomDate, Mode=TwoWay}"
                                MinDate="{x:Bind Session.Charge.FirstCustomDate}"
                                MaxDate="{x:Bind Session.Charge.LastCustomDate}" />
                            <TimePicker
                                x:Uid="Battery_At"
                                Visibility="{x:Bind Session.Charge.IsCustomDuration, Mode=OneWay}"
                                Time="{x:Bind Session.Charge.CustomTime, Mode=TwoWay}"
                                MinuteIncrement="15" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Uid="Battery_Then" VerticalAlignment="Center" />
                            <ComboBox
                                x:Uid="Battery_ThenSwitchBackTo"
                                ItemsSource="{x:Bind Session.Charge.RestoreModes}"
                                DisplayMemberPath="Label"
                                SelectedIndex="{x:Bind Session.Charge.RestoreIndex, Mode=TwoWay}" />
                            <Button
                                x:Uid="Battery_Start"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind Session.Charge.StartOverrideCommand}"
                                IsEnabled="{x:Bind Session.Charge.CanChange, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock
                            Text="{x:Bind Session.Charge.Note, Mode=OneWay}"
                            Visibility="{x:Bind Session.Charge.HasNote, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
