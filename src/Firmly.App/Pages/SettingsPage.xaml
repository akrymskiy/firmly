<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Firmly.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="32,16,32,24" Spacing="4">
            <TextBlock Margin="0,0,0,12" Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

            <TextBlock Text="General" Style="{StaticResource SectionHeaderStyle}" />
            <Grid Style="{StaticResource CardStyle}" ColumnSpacing="16" Visibility="{x:Bind ViewModel.HasTray}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon VerticalAlignment="Center" Glyph="&#xE8A7;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Keep running when the window is closed" />
                    <TextBlock
                        Text="Firmly stays in the notification area, next to the clock. To quit, right-click its icon and choose Exit."
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch
                    Grid.Column="2"
                    MinWidth="0"
                    AutomationProperties.Name="Keep running when the window is closed"
                    IsOn="{x:Bind ViewModel.CloseToTray, Mode=TwoWay}" />
            </Grid>
            <Grid Style="{StaticResource CardStyle}" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon VerticalAlignment="Center" Glyph="&#xE7E8;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Start when you sign in" />
                    <TextBlock
                        Text="Firmly starts in the notification area, without opening its window."
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{x:Bind ViewModel.StartupNote, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasStartupNote, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch
                    Grid.Column="2"
                    MinWidth="0"
                    AutomationProperties.Name="Start when you sign in"
                    IsOn="{x:Bind ViewModel.StartAtSignIn, Mode=TwoWay}"
                    IsEnabled="{x:Bind ViewModel.CanChangeStartAtSignIn, Mode=OneWay}" />
            </Grid>

            <TextBlock Text="Service" Style="{StaticResource SectionHeaderStyle}" />
            <Grid Style="{StaticResource CardStyle}" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon VerticalAlignment="Center" Glyph="&#xE912;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Firmly service" />
                    <TextBlock
                        Text="{x:Bind ViewModel.ServiceSummary, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True" />
                    <TextBlock
                        Text="{x:Bind ViewModel.ServiceProblem, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasServiceProblem, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <!-- The shield says it asks for administrator rights. -->
                <Button Grid.Column="2" VerticalAlignment="Center" Command="{x:Bind ViewModel.RestartServiceCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xEA18;" />
                        <TextBlock Text="Restart" />
                    </StackPanel>
                </Button>
            </Grid>

            <TextBlock Text="About" Style="{StaticResource SectionHeaderStyle}" />
            <Grid Style="{StaticResource CardStyle}" ColumnSpacing="16" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Image
                    Width="32"
                    Height="32"
                    VerticalAlignment="Center"
                    Source="ms-appx:///Assets/Square44x44Logo.png"
                    AutomationProperties.AccessibilityView="Raw" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Firmly" />
                    <TextBlock
                        Text="{x:Bind ViewModel.AppVersion}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True" />
                </StackPanel>
                <Button Grid.Column="2" VerticalAlignment="Center" Command="{x:Bind ViewModel.CopyDetailsCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                        <TextBlock Text="{x:Bind ViewModel.CopyLabel, Mode=OneWay}" />
                    </StackPanel>
                </Button>

                <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ColumnSpacing="12" RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Device" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Device, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <TextBlock Grid.Row="1" Text="BIOS" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.Bios, Mode=OneWay}" IsTextSelectionEnabled="True" />
                    <TextBlock Grid.Row="2" Text="Windows" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.WindowsVersion, Mode=OneWay}" IsTextSelectionEnabled="True" />
                </Grid>
            </Grid>

            <StackPanel Margin="-12,8,0,0" Orientation="Horizontal">
                <HyperlinkButton Content="Help" NavigateUri="{x:Bind ViewModel.HelpUri}" />
                <HyperlinkButton Content="Report a problem" NavigateUri="{x:Bind ViewModel.NewIssueUri, Mode=OneWay}" />
                <HyperlinkButton Content="Source code" NavigateUri="{x:Bind ViewModel.SourceUri}" />
                <HyperlinkButton Content="MIT License" NavigateUri="{x:Bind ViewModel.LicenseUri}" />
            </StackPanel>

            <TextBlock
                Margin="0,8,0,0"
                Text="{x:Bind ViewModel.Legal}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
