<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Firmly.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24,16,24,24" Spacing="4">
            <TextBlock x:Uid="Settings_Title" Margin="0,0,0,12" Style="{StaticResource TitleTextBlockStyle}" />

            <TextBlock x:Uid="Settings_General" Style="{StaticResource SectionHeaderStyle}" />
            <Grid Style="{StaticResource CardStyle}" ColumnSpacing="16" Visibility="{x:Bind ViewModel.HasTray}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon VerticalAlignment="Center" Glyph="&#xE8A7;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Uid="Settings_CloseToTray" />
                    <TextBlock
                        x:Uid="Settings_CloseToTrayExplanation"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch
                    x:Uid="Settings_CloseToTraySwitch"
                    Grid.Column="2"
                    MinWidth="0"
                    IsOn="{x:Bind ViewModel.CloseToTray, Mode=TwoWay}" />
            </Grid>
            <Grid Style="{StaticResource CardStyle}" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon VerticalAlignment="Center" Glyph="&#xE7E8;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Uid="Settings_StartAtSignIn" />
                    <TextBlock
                        x:Uid="Settings_StartAtSignInExplanation"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{x:Bind ViewModel.StartupNote, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasStartupNote, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch
                    x:Uid="Settings_StartAtSignInSwitch"
                    Grid.Column="2"
                    MinWidth="0"
                    IsOn="{x:Bind ViewModel.StartAtSignIn, Mode=TwoWay}"
                    IsEnabled="{x:Bind ViewModel.CanChangeStartAtSignIn, Mode=OneWay}" />
            </Grid>

            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.ShowsBiosPassword, Mode=OneWay}">
                <TextBlock x:Uid="Settings_BiosPasswordHeader" Style="{StaticResource SectionHeaderStyle}" />
                <Grid Style="{StaticResource CardStyle}" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon VerticalAlignment="Center" Glyph="&#xE72E;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Uid="Settings_BiosPassword" />
                        <TextBlock
                            Text="{x:Bind ViewModel.BiosPasswordExplanation, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Text="{x:Bind ViewModel.SavedPasswordText, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        x:Uid="Settings_Forget"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.HasSavedPassword, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ForgetPasswordCommand}" />
                </Grid>
                <Grid
                    Style="{StaticResource CardStyle}"
                    ColumnSpacing="16"
                    Visibility="{x:Bind ViewModel.BiosPasswordSet, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon VerticalAlignment="Top" Margin="0,4,0,0" Glyph="&#xE823;" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock x:Uid="Settings_SwitchBack" />
                        <!-- Two-way: the choice is a plain preference, kept by the view model. -->
                        <RadioButtons
                            x:Uid="Settings_SwitchBackPicker"
                            SelectedIndex="{x:Bind ViewModel.SwitchBackChoice, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.AllowSavedPassword, Mode=OneWay}">
                            <RadioButton x:Uid="Settings_SwitchBackAsk" />
                            <RadioButton x:Uid="Settings_SwitchBackAlone" />
                        </RadioButtons>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <TextBlock x:Uid="Settings_Service" Style="{StaticResource SectionHeaderStyle}" />
            <Grid Style="{StaticResource CardStyle}" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon VerticalAlignment="Center" Glyph="&#xE912;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Uid="Settings_FirmlyService" />
                    <TextBlock
                        Text="{x:Bind ViewModel.ServiceSummary, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True" />
                    <TextBlock
                        Text="{x:Bind ViewModel.ServiceProblem, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasServiceProblem, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <!-- The shield says it asks for administrator rights. -->
                <Button Grid.Column="2" VerticalAlignment="Center" Command="{x:Bind ViewModel.RestartServiceCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xEA18;" />
                        <TextBlock x:Uid="Settings_Restart" />
                    </StackPanel>
                </Button>
            </Grid>

            <TextBlock x:Uid="Settings_About" Style="{StaticResource SectionHeaderStyle}" />
            <Grid Style="{StaticResource CardStyle}" ColumnSpacing="16" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Image
                    Width="32"
                    Height="32"
                    VerticalAlignment="Center"
                    Source="ms-appx:///Assets/Square44x44Logo.png"
                    AutomationProperties.AccessibilityView="Raw" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Firmly" />
                    <TextBlock
                        Text="{x:Bind ViewModel.AppVersion}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True" />
                </StackPanel>
                <Button Grid.Column="2" VerticalAlignment="Center" Command="{x:Bind ViewModel.CopyDetailsCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                        <TextBlock Text="{x:Bind ViewModel.CopyLabel, Mode=OneWay}" />
                    </StackPanel>
                </Button>

                <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ColumnSpacing="12" RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Uid="Settings_Device" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Device, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <TextBlock x:Uid="Settings_Bios" Grid.Row="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.Bios, Mode=OneWay}" IsTextSelectionEnabled="True" />
                    <TextBlock x:Uid="Settings_Windows" Grid.Row="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.WindowsVersion, Mode=OneWay}" IsTextSelectionEnabled="True" />
                </Grid>
            </Grid>

            <StackPanel Margin="-12,8,0,0" Orientation="Horizontal">
                <HyperlinkButton x:Uid="Settings_Help" NavigateUri="{x:Bind ViewModel.HelpUri}" />
                <HyperlinkButton x:Uid="Settings_ReportAProblem" NavigateUri="{x:Bind ViewModel.NewIssueUri, Mode=OneWay}" />
                <HyperlinkButton x:Uid="Settings_SourceCode" NavigateUri="{x:Bind ViewModel.SourceUri}" />
                <HyperlinkButton x:Uid="Settings_License" NavigateUri="{x:Bind ViewModel.LicenseUri}" />
            </StackPanel>

            <TextBlock
                Margin="0,8,0,0"
                Text="{x:Bind ViewModel.Legal}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
