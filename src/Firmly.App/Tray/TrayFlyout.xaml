<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Firmly.App.Tray.TrayFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Firmly.App.ViewModels"
    Title="Firmly">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <!-- On a canvas the panel takes its natural height, and the window is sized to that.
         Tab goes round within the panel, and arrow keys move between controls, as in Windows' own flyouts. -->
    <Canvas>
        <Grid
            x:Name="Panel"
            Width="360"
            KeyDown="OnPanelKeyDown"
            TabFocusNavigation="Cycle"
            XYFocusKeyboardNavigation="Enabled">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Padding="20,16,20,20" Spacing="4">
                <TextBlock
                    Text="{x:Bind ChargeOrNone(Session.Battery.Charge), Mode=OneWay}"
                    Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    Text="{x:Bind Session.Battery.Details, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />

                <InfoBar
                    Margin="0,12,0,0"
                    IsOpen="{x:Bind Session.Charge.HasOverride, Mode=OneWay}"
                    IsClosable="False"
                    Severity="Success"
                    Title="{x:Bind Session.Charge.OverrideTitle, Mode=OneWay}"
                    Message="{x:Bind Session.Charge.OverrideMessage, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button
                            Content="Switch back now"
                            Command="{x:Bind Session.Charge.SwitchBackNowCommand}"
                            IsEnabled="{x:Bind Session.Charge.CanChange, Mode=OneWay}" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <StackPanel Spacing="4" Visibility="{x:Bind Session.Charge.HasModes, Mode=OneWay}">
                    <TextBlock Margin="0,12,0,0" Text="Charge mode" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <!-- One-way, as on the Battery page: user picks are handled in code-behind. -->
                    <RadioButtons
                        x:Name="ModePicker"
                        AutomationProperties.Name="Charge mode"
                        ItemsSource="{x:Bind Session.Charge.Modes}"
                        SelectedIndex="{x:Bind Session.Charge.SelectedIndex, Mode=OneWay}"
                        IsEnabled="{x:Bind Session.Charge.CanChange, Mode=OneWay}"
                        SelectionChanged="OnModeSelectionChanged">
                        <RadioButtons.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChargeModeOption">
                                <TextBlock Text="{x:Bind Label}" ToolTipService.ToolTip="{x:Bind Explanation}" />
                            </DataTemplate>
                        </RadioButtons.ItemTemplate>
                    </RadioButtons>
                    <TextBlock
                        Text="{x:Bind Session.Charge.Note, Mode=OneWay}"
                        Visibility="{x:Bind Session.Charge.HasNote, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <DropDownButton
                        Margin="0,8,0,0"
                        Content="Full charge for…"
                        Visibility="{x:Bind Session.Charge.IsOverrideOffered, Mode=OneWay}"
                        IsEnabled="{x:Bind Session.Charge.CanChange, Mode=OneWay}">
                        <DropDownButton.Flyout>
                            <MenuFlyout x:Name="DurationMenu" Placement="BottomEdgeAlignedLeft" Opening="OnDurationMenuOpening" />
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </StackPanel>
            </StackPanel>

            <!-- A footer like the one under Windows' quick settings. -->
            <Grid
                Grid.Row="1"
                Padding="20,8,12,8"
                ColumnSpacing="4"
                Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Text="{x:Bind Session.Status, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind Session.Status, Mode=OneWay}" />
                <Button Grid.Column="1" Content="{x:Bind OpenText}" Click="OnOpenClick" />
                <Button
                    Grid.Column="2"
                    Click="OnSettingsClick"
                    AutomationProperties.Name="Settings"
                    ToolTipService.ToolTip="Settings">
                    <FontIcon FontSize="16" Glyph="&#xE713;" />
                </Button>
            </Grid>
        </Grid>
    </Canvas>
</Window>
